# Copy to .env and fill in real values. Never commit .env.

# Runtime environment: development | production
ENV=development

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stratos

# --- Redis (broker for Celery, separate DB for pub/sub) ---
REDIS_BROKER_URL=redis://localhost:6379/0
REDIS_PUBSUB_URL=redis://localhost:6379/1

# --- Astra (vector evidence store) ---
ASTRA_DB_API_ENDPOINT=
ASTRA_DB_APPLICATION_TOKEN=
ASTRA_DB_KEYSPACE=

# --- Auth ---
# Google OAuth client ID (Web application type) from
# https://console.google.com/apis/credentials — required, even in dev.
# Must match NEXT_PUBLIC_GOOGLE_CLIENT_ID in stratos-frontend/.env.local.
GOOGLE_CLIENT_ID=
# HS256 signing secret for internal session JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Must NOT be "supersecret" in production (boot will refuse to start).
JWT_SECRET=supersecret
# Dev-only escape hatch: literal token "dev" authenticates as a seeded
# dev user. Only takes effect when ENV=development. Must be false in prod.
DEV_AUTH_BYPASS=false

# --- LLM ---
LLM_PROVIDER=groq
GROQ_API_KEY=

# --- Research ---
SERP_API_KEY=

# --- Exports / storage ---
# local -> serve PDFs from disk (fast-ship). r2 -> presigned object storage (premium).
EXPORT_STORAGE=local
EXPORT_DIR=exports

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:3000

# --- Rate limiting / cost guardrails ---
START_SESSION_RATE=5/hour
CLARIFICATION_CHAT_RATE=60/hour
GLOBAL_DAILY_SESSION_CAP=100

# --- Input caps (security §3) ---
MAX_TEXT_LENGTH=2000
