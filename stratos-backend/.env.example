# Copy to .env and fill in real values. Never commit .env.

# Runtime environment: development | production
ENV=development

# --- Database ---
DATABASE_URL=postgresql://stratos:stratos@localhost:5432/stratos

# --- Redis (broker for Celery, separate DB for pub/sub) ---
REDIS_BROKER_URL=redis://localhost:6379/0
REDIS_PUBSUB_URL=redis://localhost:6379/1

# --- Astra (vector evidence store) ---
ASTRA_DB_API_ENDPOINT=
ASTRA_DB_APPLICATION_TOKEN=
ASTRA_DB_KEYSPACE=

# --- Auth ---
# Google OAuth client ID (Web application type) from
# https://console.google.com/apis/credentials — required, even in dev.
# Must match NEXT_PUBLIC_GOOGLE_CLIENT_ID in stratos-frontend/.env.local.
GOOGLE_CLIENT_ID=
# HS256 signing secret for internal session JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Must NOT be "supersecret" in production (boot will refuse to start).
JWT_SECRET=supersecret
# Dev-only escape hatch: literal token "dev" authenticates as a seeded
# dev user. Only takes effect when ENV=development. Must be false in prod.
DEV_AUTH_BYPASS=false

# --- LLM ---
# Two Groq API keys/accounts, used as a fallback pool (app/llm/client.py)
# to roughly double the effective daily token quota.
GROQ_API_KEY_ALISHA=
GROQ_API_KEY_ENCRIL=
# Optional (2026-09-14 remediation Phase 3) -- a free Gemini account (no
# card needed, get one at aistudio.google.com/apikey). Free tier on
# gemini-3.1-flash-lite (the model actually in use) is 15 RPM, 250,000
# TPM, 1,000 RPD, vs Groq's per-account 8K TPM. Everything works
# unchanged if left unset; only consumed for tasks listed in
# app/llm/client_federated.py's FEDERATED_ROUTES.
GEMINI_API_KEY=
# Optional account-registry override (app/llm/registry.py) -- leave unset
# to keep using the two Groq accounts above unchanged. See registry.py's
# docstring for the full comma-separated format.
# LLM_ACCOUNTS=

# --- Research ---
SERP_API_KEY=

# --- Trends ---
# Optional, default false (2026-09-14 remediation Phase 5): the GDELT
# provider failed 4/4 queries in the audited live run -- opt-in until its
# reliability is reassessed. The other three trend providers (HN, Google
# News RSS, arXiv) are unaffected either way.
GDELT_ENABLED=false

# --- Competitors ---
# Free, non-expiring developer token: Product Hunt account -> API Dashboard ->
# "New Application" -> developer_token. Optional: worker falls back to
# Hacker News (Show HN) only when this is unset.
PRODUCT_HUNT_TOKEN=
# Max number of verified competitors profiled per report.
COMPETITOR_MAX=7

# --- Exports / storage ---
# local -> serve PDFs from disk (fast-ship). r2 -> presigned object storage (premium).
EXPORT_STORAGE=local
EXPORT_DIR=exports

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:3000

# --- Rate limiting / cost guardrails ---
START_SESSION_RATE=5/hour
CLARIFICATION_CHAT_RATE=60/hour
GLOBAL_DAILY_SESSION_CAP=100

# --- Input caps (security §3) ---
MAX_TEXT_LENGTH=2000
