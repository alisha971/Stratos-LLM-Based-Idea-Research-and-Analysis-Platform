# Copy to .env.local and fill in real values. Never commit .env.local.

# Base URL of the Stratos backend API. No trailing slash.
# Local dev: http://localhost:8000
# Production: https://api.yourdomain.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Google OAuth client ID (Web application type) from
# https://console.cloud.google.com/apis/credentials
# Must match GOOGLE_CLIENT_ID in stratos-backend/.env.
# Leave EMPTY in local dev to get the dev-mode sign-in button instead
# (requires DEV_AUTH_BYPASS=true on the backend).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
